# --- Required ---
ASSEMBLYAI_API_KEY=your_assemblyai_key
GROQ_API_KEY=your_groq_key

# --- Optional: translation model (check your Groq console for current names) ---
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional: speech-to-text ---
STT_MODEL=universal-3-5-pro
STT_MODE=balanced          # balanced | min_latency | max_accuracy

# --- Voice output ---
# browser     = free, uses the browser's built-in voices (works out of the box)
# elevenlabs  = real streaming TTS, needs the two keys below
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
